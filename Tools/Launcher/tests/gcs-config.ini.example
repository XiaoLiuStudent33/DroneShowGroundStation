# Test fixture only. Never bind the aircraft network during automated tests.
safe_test_mode=true
mavlink_network_enabled=true
real_command_enabled=false
route_upload_enabled=false
mavlink_bind_ip=127.0.0.1
mavlink_bind_port=10091
heartbeat_timeout_ms=3000
dspgcs_telemetry_enabled=true
dspgcs_command_enabled=false
dspgcs_transport_config=config/DSPGCSTransport.ini
dspgcs_telemetry_interval_ms=250
