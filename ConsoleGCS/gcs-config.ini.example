# Copy this file to gcs-config.ini before running the program.
# Keep true for safe operation and all automated tests.
safe_test_mode=true

# Production is the only runtime path. Review the bind endpoint, then set true.
mavlink_network_enabled=false
real_command_enabled=false
route_upload_enabled=false
mavlink_bind_ip=0.0.0.0
# Example-only port. It is not used by the checked-in Production deployment.
mavlink_bind_port=10005
heartbeat_timeout_ms=3000

dspgcs_telemetry_enabled=false
dspgcs_command_enabled=false
dspgcs_transport_config=config/DSPGCSTransport.ini
dspgcs_telemetry_interval_ms=250

# Local-only UTF-8 absolute path shared with UE Artifact generation settings.
# DSP messages must never carry this path. Uncomment after choosing the root.
# artifact_workspace_root=C:/DroneGCSData/ArtifactWorkspace

# Optional Production performance tuning. These values match code fallbacks.
[performance]
mavlink_receive_buffer_bytes=4194304
max_packets_per_drain=4096
snapshot_datagram_bytes=61440
snapshot_items_per_chunk=512

# Route Upload uses MAVFTP only. These five parameters are the frozen
# production profile; there is no Transport selection key.
[mavftp]
segment_items=4000
request_timeout_ms=750
terminate_timeout_ms=2500
request_retry_count=3
write_window=16

[max_flight]
# Positive values in meters. Missing keys fall back to 5.0m.
takeoff_altitude_limit=5.0
hover_altitude_limit=5.0
